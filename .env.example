# Native clients need a reachable adapter origin. Web always uses its own origin.
EXPO_PUBLIC_ADAPTER_ORIGIN=
# Normal startup uses https://bouldy-api.onrender.com through the local adapter.
# npm run start:fixture explicitly selects the isolated local test API instead.
# No tokens or passwords belong here.
BOULDY_LOCAL_API=
EXPO_PUBLIC_FIXTURE_PREVIEW=0
# Server-only. Comma-separated user IDs allowed to manage gyms and routes (default: nobody).
# The "Manage gyms" row appears on the You tab for these users only.
BOULDY_ADMIN_USER_IDS=
