  "narrative": {
    "northStar": "The Climber\u2019s Logbook",
    "overview": "This records the existing visual direction, not a new proposal. Bouldy feels like a compact personal logbook used between attempts: direct, easy to scan and specific to climbing. Condensed gym-signage headings sit above calm interface text. Detailed hold artwork and the Bolt B mark provide identity without turning records into decoration.\n\nThe canonical [migration specification](docs/REACT_NATIVE_MIGRATION_SPEC.md) governs exact parity. This document describes the current Expo implementation, checked against the preserved [source design](docs/SOURCE_DESIGN.md), theme modules and [Android fixture captures](docs/screenshots/android/README.md) on 29 October 2026. Captures establish visual evidence, not accepted parity. Any difference between source, code and this record must be reported and resolved rather than silently redesigned.",
    "keyCharacteristics": [
      "A light phone canvas with restrained dark summaries and one action accent.",
      "Condensed uppercase headings, readable Geist controls and accurate session data.",
      "Flat records, pill actions, detailed climbing holds and purposeful state feedback.",
      "Shared branded UI with working native safe areas, keyboard behaviour and dismissal."
    ],
    "rules": [
      {
        "name": "The One Red Rule",
        "body": "One shared action accent establishes hierarchy; do not assign unrelated accent themes per route or tab.",
        "section": "colors"
      },
      {
        "name": "The Paired Surface Rule",
        "body": "Dark summaries use the panel text tokens, while semantic badges keep their matched foreground/background pair.",
        "section": "colors"
      },
      {
        "name": "The Two-Voice Rule",
        "body": "Condensed type identifies climbing content; Geist makes controls and journal detail readable. Do not replace either family with a platform default as a migration shortcut.",
        "section": "typography"
      },
      {
        "name": "The Phone Canvas Rule",
        "body": "Wider screens retain the same app hierarchy and reading width; no sidebar, desktop dashboard or decorative phone frame is implied.",
        "section": "layout"
      },
      {
        "name": "The State-Only Lift Rule",
        "body": "Elevation belongs to transient feedback or overlays. The current snackbar has an explicit soft shadow; that is not permission to add decorative shadows to resting cards. Button press feedback uses the existing downward movement and slight compression.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve the exact approved source copy, interface, assets and business semantics.",
      "**Do** reuse shared primitives, theme roles, platform boundaries and reduced-motion handling.",
      "**Do** verify safe areas, keyboard access, focus, text scaling and touch targets on the affected platform.",
      "**Do** compare matching route/data/state captures before accepting visual parity.",
      "**Do** record a visual/accessibility conflict explicitly and resolve it with the product owner."
    ],
    "donts": [
      "**Don't** redesign the migration into a stock iOS/Material app or a wide desktop dashboard.",
      "**Don't** add cream/beige palettes, glass effects, decorative gradients, nested cards or generic icon-card grids.",
      "**Don't** replace the supplied fonts, Bolt B or hold artwork with approximations.",
      "**Don't** hide failed reads, ambiguous history, missing content or unverified platform behaviour.",
      "**Don't** treat these specifications, generated component previews or a Done card as proof of release readiness."
    ]
  }
}
