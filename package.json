{
  "name": "bouldy-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24.11.1"
  },
  "scripts": {
    "start": "node scripts/start-preview.cjs live",
    "start:live": "node scripts/start-preview.cjs live",
    "start:fixture": "node scripts/start-preview.cjs fixture",
    "web": "node scripts/start-preview.cjs live --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint src scripts tests",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build": "expo export --platform web",
    "export:native": "expo export --platform ios --platform android",
    "fixture": "node scripts/fixture-api.cjs",
    "test:e2e": "playwright test",
    "prebuild": "node scripts/prepare-pwa.cjs",
    "start:phone": "node scripts/start-preview.cjs live --lan"
  },
  "dependencies": {
    "@react-native-picker/picker": "2.11.4",
    "expo": "58.0.21",
    "expo-constants": "58.0.14",
    "expo-font": "58.0.11",
    "expo-image": "58.0.18",
    "expo-linking": "58.0.15",
    "expo-router": "58.0.28",
    "expo-secure-store": "58.0.2",
    "expo-status-bar": "58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "eslint": "9.39.1",
    "eslint-config-expo": "58.0.4",
    "@types/react": "19.3.0",
    "@types/node": "24.10.1",
    "@playwright/test": "1.58.2"
  }
}
